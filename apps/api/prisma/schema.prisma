generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TREASURER
  SECRETARY
  AUDITOR
  MEMBER
}

enum Frequency {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model User {
  id           Int      @id @default(autoincrement())
  email        String?  @unique
  mobile       String?  @unique @db.VarChar(20)
  member       Member?
  passwordHash String
  role         Role     @default(MEMBER)
  name         String
  createdAt    DateTime @default(now())
}

model Member {
  id            Int            @id @default(autoincrement())
  name          String
  mobile        String?        @unique @db.VarChar(20)
  village       String?
  email         String?
  familyId      String?
  aadhaarNumber String? @db.VarChar(12)
  createdAt     DateTime       @default(now())
  userId        Int?           @unique
  user          User?          @relation(fields: [userId], references: [id])
  contributions Contribution[]
  donations     Donation[]
}

model Contribution {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id])
  amount    Decimal   @db.Decimal(12, 2)
  frequency Frequency
  startDate DateTime
  active    Boolean   @default(true)
  publicVisible Boolean @default(false)
  createdAt DateTime  @default(now())
}

model Donation {
  id            Int           @id @default(autoincrement())
  memberId      Int?
  member        Member?       @relation(fields: [memberId], references: [id])
  donorName     String
  amount        Decimal       @db.Decimal(12, 2)
  method        String        @default("CASH")
  reference     String?       @unique
  status        PaymentStatus @default(PENDING)
  purpose       String        @default("GENERAL")
  receiptNumber String?       @unique
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?
}

model Expense {
  id          Int           @id @default(autoincrement())
  description String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  vendor      String?
  billUrl     String?
  status      ExpenseStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  approvedAt  DateTime?
}

model Committee {
  id        Int               @id @default(autoincrement())
  title     String
  startDate DateTime
  endDate   DateTime?
  current   Boolean           @default(false)
  members   CommitteeMember[]
}

model CommitteeMember {
  id          Int       @id @default(autoincrement())
  committeeId Int
  committee   Committee @relation(fields: [committeeId], references: [id])
  name        String
  position    String
  photoUrl    String?
  description String?
}

model Setting {
  key   String @id
  value String @db.LongText
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String?
  details   String?  @db.LongText
  createdAt DateTime @default(now())
}
